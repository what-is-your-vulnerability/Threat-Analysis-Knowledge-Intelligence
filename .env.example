# 복사해서 .env로 쓴다(.env는 커밋하지 않는다). 셸에 이미 있는 값이 먼저다.
# OpenAI 키는 api.openai.com으로만 보낸다.
OPENAI_API_KEY=
# OpenAI가 아닌 OpenAI 호환 주소를 쓸 때만
# LLM_BASE_URL=
# LLM_API_KEY=

# LangSmith 기록. TAKI_LANGSMITH_PROJECT를 적었을 때만 보낸다.
LANGSMITH_API_KEY=
TAKI_LANGSMITH_PROJECT=taki
# EU 지역 계정이면
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
