<!doctype html>
<html lang="ko">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>보안 진단 리포트</title>
<style>
:root { color-scheme: light dark; --fg:#1b1f24; --muted:#59636e; --line:#d1d9e0; --bg:#fff; --code:#f6f8fa; --warn:#9a6700; --block:#cf222e; --ok:#1a7f37; }
@media (prefers-color-scheme: dark) { :root { --fg:#e6edf3; --muted:#9198a1; --line:#3d444d; --bg:#0d1117; --code:#161b22; --warn:#d29922; --block:#f85149; --ok:#3fb950; } }
body { font: 15px/1.6 system-ui, sans-serif; color: var(--fg); background: var(--bg); max-width: 960px; margin: 0 auto; padding: 24px 16px; }
h1 { font-size: 24px; } h2 { font-size: 19px; margin-top: 32px; border-bottom: 1px solid var(--line); padding-bottom: 6px; }
h3 { font-size: 16px; margin-bottom: 4px; } .muted { color: var(--muted); font-size: 13px; }
.card { border: 1px solid var(--line); border-radius: 8px; padding: 12px 16px; margin: 12px 0; }
pre { background: var(--code); padding: 10px; overflow-x: auto; border-radius: 6px; font-size: 13px; }
code { font-size: 13px; } table { border-collapse: collapse; width: 100%; font-size: 14px; }
td, th { border-bottom: 1px solid var(--line); padding: 6px 8px; text-align: left; vertical-align: top; }
.warn { color: var(--warn); font-weight: 600; } .block { color: var(--block); font-weight: 600; } .pass { color: var(--ok); font-weight: 600; }
</style>
</head>
<body>
<h1>보안 진단 리포트</h1>
<p class="muted">대상 {{ target }}{% if commit %} · 커밋 {{ commit }}{% endif %} · 검사 방식 {{ mode }} · 결과 <span class="{{ overall.css }}">{{ overall.label }}</span></p>
<p class="muted">AI가 작성한 잠정 결과입니다. 검증 불충분과 못 본 범위는 문제가 없다는 뜻이 아닙니다.</p>
{% if error %}<p class="block">실행 실패: {{ error }}</p>{% endif %}

<h2>이슈 {{ findings|length }}건</h2>
{% for f in findings %}
<div class="card">
  <h3>{{ state_labels[f.state] }} · <span class="{{ f.outcome }}">{{ outcome_labels.get(f.outcome, '-') }}</span>{% if f.cwe %} · {{ f.cwe }}{% endif %}</h3>
  <p>{{ f.statement }}</p>
  <p class="muted">위치: {{ f.root_file or '알 수 없음' }}{% if f.root_symbol %} · {{ f.root_symbol }}{% endif %}{% if f.broken_rule %} · 규칙 {{ f.broken_rule }}{% endif %}{% if f.flows %} · API: {{ f.flows|join(', ') }}{% endif %}</p>
  {% for e in f.evidence %}
  {% if e.basis %}<p class="muted">판정 근거: {{ e.basis|join(' · ') }}</p>{% endif %}
  {% for h in e.hops %}<p class="muted">{{ h.file }}:{{ h.start }}{% if h.end != h.start %}-{{ h.end }}{% endif %}</p><pre><code>{{ h.quote }}</code></pre>{% endfor %}
  {% endfor %}
  {% if f.fix %}
  <h3>수정 방법</h3>
  <p class="muted">{{ f.fix.location }}</p>
  <pre><code>{{ f.fix.code_example }}</code></pre>
  <p>확인 방법: {{ f.fix.check_scenario }}</p>
  {% endif %}
</div>
{% else %}<p>보고할 이슈가 없습니다.</p>{% endfor %}

{% if recheck %}
<h2>재검사 비교</h2>
<table><tr><th>조사 항목</th><th>변화</th></tr>
{% for i in recheck %}<tr><td>{{ i.case_id }}</td><td>{{ recheck_labels.get(i.change, i.change) }} ({{ i.change }})</td></tr>{% endfor %}
</table>
{% endif %}

<h2>판정 {{ verdicts|length }}건</h2>
<table><tr><th>판정</th><th>조사 항목</th><th>이유</th></tr>
{% for v in verdicts %}<tr><td>{{ state_labels[v.state] }}</td><td>{{ questions.get(v.case_id, v.case_id) }}</td><td>{{ v.reason }}</td></tr>{% endfor %}
</table>

<h2>못 본 범위</h2>
<table><tr><th>대상</th><th>이유</th></tr>
{% for c in not_seen %}<tr><td>{{ c.subject }} · {{ c.target }}</td><td>{{ c.reason }}</td></tr>{% endfor %}
{% for s in truncated %}<tr><td>{{ s.name }}</td><td>{{ s.reason }}</td></tr>{% endfor %}
{% for n in not_read %}<tr><td>{{ n.path }}</td><td>{{ n.reason }}</td></tr>{% endfor %}
</table>
</body>
</html>
